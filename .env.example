# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Scraping sources
YAD2_BASE_URL=https://www.yad2.co.il
MADLAN_BASE_URL=https://www.madlan.co.il
TAX_AUTHORITY_API_URL=https://www.nadlan.gov.il/Nadlan.REST/Main/GetAssestAndDeals

# Apify (for Madlan scraping)
# Sign up at https://apify.com and get your token at https://console.apify.com/account/integrations
APIFY_API_TOKEN=
APIFY_MADLAN_ACTOR_ID=swerve/madlan-scraper

# Competitor search (for Market Analysis tab)
# Pick ONE provider - set provider name in COMPETITOR_SEARCH_PROVIDER
# Tavily ($0.003/search, extracts content - preferred): https://tavily.com
# Serper ($0.001/search, returns SERP only): https://serper.dev
COMPETITOR_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPER_API_KEY=

# AI Market Reports (Gemini)
# Get a free API key at https://aistudio.google.com/apikey
# Free tier: 15 requests/min, 1500/day - enough for testing
GEMINI_API_KEY=

# Branding (used in PDF prospectus)
NEXT_PUBLIC_BRAND_NAME=Nadlan Pro
NEXT_PUBLIC_BRAND_LOGO_TEXT=Nadlan Pro

# Rate limiting
SCRAPER_USER_AGENT=RealEstatePlatform/1.0
SCRAPER_REQUEST_DELAY_MS=2000
SCRAPER_MAX_CONCURRENT=3

# Security
NEXTAUTH_SECRET=generate-a-secret-with-openssl-rand-base64-32
CRON_SECRET=generate-another-secret-for-cron-endpoints
